<?xml version="1.0" encoding="utf-8"?>
<!-- The pet widget below PetWidgetProvider.WIDE_MIN_DP of width; widget_pet.xml is the wide one and shares its ids. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pet_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pet_widget_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Zwierzak"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pet_widget_stroke"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_secondary"
            android:contentDescription="Pogłaszcz"
            android:gravity="center"
            android:text="♥"
            android:textColor="@color/widget_accent"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Stands in until the app has drawn the pet (PetWidgetBridge) -->
        <TextView
            android:id="@+id/pet_widget_emoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="🐹"
            android:textSize="40sp" />

        <ImageView
            android:id="@+id/pet_widget_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Sytość, radość, forma — in the app's colours -->
    <LinearLayout
        android:id="@+id/pet_widget_bars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/pet_widget_hunger"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="80"
            android:progressDrawable="@drawable/pet_widget_bar_hunger" />

        <ProgressBar
            android:id="@+id/pet_widget_joy"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="70"
            android:progressDrawable="@drawable/pet_widget_bar_joy" />

        <ProgressBar
            android:id="@+id/pet_widget_form"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/pet_widget_bar_form" />
    </LinearLayout>
</LinearLayout>
